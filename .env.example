# Variables leídas por docker-compose.yml (raíz del repo) al levantar el
# stack en producción — distinto de apps/backend/.env.example, que es el
# .env propio del proceso Node dentro del contenedor `backend`.
# Ver docs/Plan_Despliegue.md para el resto del checklist de deploy.

# Password del usuario de Postgres de ESTE proyecto (contenedor propio, no
# compartido con otros ecosistemas que convivan en la misma VPS). Generar
# uno largo y random — el mismo valor va también en DATABASE_URL de
# apps/backend/.env.
POSTGRES_PASSWORD=

# Dominios reales de este proyecto (una vez que estén decididos y con el DNS
# apuntando a la IP de la VPS) — se usan en los labels de Caddy y como
# VITE_API_URL horneado en el build de la web. Cambiarlos implica
# reconstruir las imágenes (docker compose build), no alcanza con reiniciar.
APP_DOMAIN=app.tudominio.com
API_DOMAIN=api.tudominio.com
