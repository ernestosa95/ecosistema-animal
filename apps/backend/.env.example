# Puerto del backend.
PORT=3000

# 'pglite' para dev local (Postgres embebido en proceso, no requiere instalar nada,
# persiste en DATABASE_PATH) o 'node-postgres' para un Postgres real (prod).
DATABASE_DRIVER=pglite
DATABASE_PATH=./pgdata
# Sólo si DATABASE_DRIVER=node-postgres:
# DATABASE_URL=postgres://usuario:password@localhost:5432/ecosistema

# Generar uno propio y random para cada ambiente — nunca reusar este valor de ejemplo.
# openssl rand -hex 32
JWT_SECRET=cambiame-por-un-valor-random-largo
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Emails con acceso a /admin (separados por coma si son varios).
SUPERADMIN_EMAILS=tu-email@dominio.com

# URL pública de la web (apps/web) — se usa para armar los links del portal del dueño
# (magic-link y, en prod, el mismo dominio que sirve la SPA).
PORTAL_URL=http://localhost:5173
PORTAL_BASE_URL=http://localhost:5173

# URL pública del propio backend — queda grabada en animales.foto_url al subir una foto
# desde el portal (POST /portal/animales/:id/foto). Tiene que ser el origen real y
# alcanzable desde afuera; en dev el default (localhost:3000) alcanza.
BACKEND_PUBLIC_URL=http://localhost:3000

# Envío de emails transaccionales (hoy sólo "olvidé mi contraseña") vía Resend
# (resend.com). Sin API key, el email queda sólo logueado en la consola del
# backend en vez de enviarse — sirve para dev sin cuenta creada.
RESEND_API_KEY=
# Remitente — mientras no haya un dominio propio verificado en Resend, usar
# el dominio de pruebas onboarding@resend.dev (sólo llega a tu propio email
# de cuenta de Resend, no sirve para producción real).
MAIL_FROM=Huella <onboarding@resend.dev>

# Orígenes permitidos por CORS, separados por coma (ej.
# "https://app.tudominio.com"). Sin definir, CORS queda abierto a cualquier
# origen — cómodo en dev local, pero hay que completarlo antes de exponer el
# backend a internet real.
CORS_ORIGIN=
